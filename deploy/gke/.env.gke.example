# Phoring — GKE runtime environment.
# Copy to deploy/gke/.env.gke, fill in real keys, then:
#   bash deploy/gke/create-secret.sh deploy/gke/.env.gke
# This file is gitignored — never commit the filled-in copy.

# ===== Primary LLM (live deploy uses Google Gemini 2.5 Pro) =====
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL_NAME=gemini-2.5-pro

# ===== Zep Cloud (REQUIRED — knowledge-graph memory layer) =====
ZEP_API_KEY=your_zep_api_key_here

# ===== Web intelligence (recommended) =====
SERPER_API_KEY=your_serper_key_here
NEWS_API_KEY=your_newsapi_key_here

# ===== Multi-AI consensus validators =====
LLM_VALIDATOR_2_API_KEY=your_openai_api_key_here
LLM_VALIDATOR_2_BASE_URL=https://api.openai.com/v1
LLM_VALIDATOR_2_MODEL_NAME=gpt-4o-mini
LLM_VALIDATOR_3_API_KEY=your_gemini_key_here
LLM_VALIDATOR_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_VALIDATOR_3_MODEL_NAME=gemini-2.5-flash

# ===== Runtime =====
PORT=10000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False
SIMULATION_SPEED_MODE=normal
ENABLE_GEOPOLITICAL_EVENTS=true

# ===== Google Cloud integrations (Workload Identity provides ADC) =====
GCP_PROJECT_ID=phoring-501306
ENABLE_GCS=true
GCS_BUCKET=phoring-artifacts-501306
ENABLE_BIGQUERY=true
BIGQUERY_DATASET=phoring_telemetry
# Do NOT set GOOGLE_APPLICATION_CREDENTIALS on GKE — the phoring-telemetry
# Kubernetes ServiceAccount is bound to the GCP SA via Workload Identity.