# ============================================================
# Phoring — GCE runtime environment (copy to /opt/phoring/.env)
# vm-setup.sh already drops a copy at /opt/phoring/.env on the VM.
# Edit it with real keys, then: sudo systemctl restart phoring
# ============================================================

# ===== Primary LLM (any OpenAI SDK-compatible provider) =====
# Live deployment uses Google Gemini 2.5 Pro via the Gemini API — strongest
# 2025 reasoning model. Verified on the synchronous ontology build step
# (~33s, HTTP 200, valid JSON) after the token budgets were raised to 16384
# (the earlier 4096 cap truncated the ontology JSON). Roll back to
# gemini-2.5-flash if latency becomes a problem behind a tight proxy timeout.
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL_NAME=gemini-2.5-pro

# ===== Zep Cloud (REQUIRED — knowledge-graph memory layer) =====
ZEP_API_KEY=your_zep_api_key_here

# ===== Web intelligence (recommended) =====
SERPER_API_KEY=your_serper_key_here
NEWS_API_KEY=your_newsapi_key_here

# ===== Multi-AI consensus validators =====
# Validator 2 — OpenAI gpt-4o-mini (different family from primary = real
# consensus diversity). Live deploy uses this for cross-family validation.
LLM_VALIDATOR_2_API_KEY=your_openai_api_key_here
LLM_VALIDATOR_2_BASE_URL=https://api.openai.com/v1
LLM_VALIDATOR_2_MODEL_NAME=gpt-4o-mini
# Validator 3 — Gemini 2.5 Flash (fast, cheaper tier) via the Gemini API.
LLM_VALIDATOR_3_API_KEY=your_gemini_api_key_here
LLM_VALIDATOR_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_VALIDATOR_3_MODEL_NAME=gemini-2.5-flash

# ===== Optional boost LLM (leave unset to ignore) =====
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=

# ===== Runtime — DO NOT change PORT (container + Caddy expect 10000) =====
PORT=10000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False
SIMULATION_SPEED_MODE=normal            # normal | fast | express
ENABLE_GEOPOLITICAL_EVENTS=true

# ===== Google Cloud integrations (optional, default off) =====
# BigQuery telemetry + Cloud Storage artifact mirror. No-ops when unset.
# Run deploy/gcp/setup_gcp.sh to create the bucket, dataset, tables, and SA.
# On GCE, attach the phoring-telemetry SA to this VM (or run
# `gcloud auth application-default login`) for ADC — no key file needed.
# GCP_PROJECT_ID=phoring-501306
# ENABLE_GCS=true
# GCS_BUCKET=phoring-artifacts-501306
# ENABLE_BIGQUERY=true
# BIGQUERY_DATASET=phoring_telemetry

# Landing + /app + /api are same-origin on this host, so CORS is mostly
# unused in production. Set your real https host if you ever split origins.
CORS_ORIGINS=https://phoring.inbharat.ai